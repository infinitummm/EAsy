{
  "appId": "com.itero.local",
  "productName": "Itero Local",
  "directories": {
    "output": "C:/Users/Administrator/itero-release"
  },
  "electronDist": "./electron-base",
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Itero Local"
  }
}
