{
  "appId": "com.itero.local",
  "productName": "EAsy",
  "artifactName": "${productName} Setup ${version}.${ext}",
  "directories": {
    "output": "C:/Users/Administrator/AppData/Local/Temp/easy-build"
  },
  "electronDist": "./electron-base",
  "files": [
    "dist/**/*",
    "package.json",
    "eng.traineddata",
    "spa.traineddata",
    "node_modules/tesseract.js/**/*",
    "node_modules/tesseract.js-core/**/*",
    "!**/itero.db*",
    "!**/itero.key*",
    "!**/itero.salt*",
    "!**/*.log",
    "!**/tests/**"
  ],
  "asarUnpack": [
    "eng.traineddata",
    "spa.traineddata",
    "**/node_modules/tesseract.js/**",
    "**/node_modules/tesseract.js-core/**"
  ],
  "publish": {
    "provider": "github",
    "owner": "infinitummm",
    "repo": "EAsy"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "EAsy",
    "uninstallDisplayName": "EAsy (Desinstalar)",
    "deleteAppDataOnUninstall": false
  }
}
